<?xml version="1.0" encoding="utf-8"?>
<!-- 端末から端末への移行でも同期の鍵を写さない(allowBackup=false だけでは Android 12 からの移行を止められない) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sync_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sync_key.xml" />
    </device-transfer>
</data-extraction-rules>
