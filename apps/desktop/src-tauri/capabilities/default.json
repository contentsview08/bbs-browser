{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限。掲示板はどこにあるか分からないので、http/https の通信はすべて許可する",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*:*/*" }, { "url": "http://*:*/*" }, { "url": "https://*/*" }, { "url": "http://*/*" }]
    }
  ]
}
