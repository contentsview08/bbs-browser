{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限。掲示板はどこにあるか分からないので、http/https の通信はすべて許可する。ウィンドウ枠はアプリで描くので、最小化・最大化・閉じる・ドラッグを許可する",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*:*/*" }, { "url": "http://*:*/*" }, { "url": "https://*/*" }, { "url": "http://*/*" }]
    }
  ]
}
