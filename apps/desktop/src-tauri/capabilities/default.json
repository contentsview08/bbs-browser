{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メイン・設定・NG のウィンドウの権限。掲示板はどこにあるか分からないので、http/https の通信はすべて許可する。ウィンドウ枠はアプリで描くので、最小化・最大化・閉じる・ドラッグを許可する。更新は確かめる・落とす・入れるの 3 つだけ(画面からは plugin-updater の署名を確かめる道でしか入れ替えられない)",
  "windows": ["main", "settings", "ng"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:allow-open",
    "notification:default",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "process:allow-restart",
    "sql:default",
    "sql:allow-execute",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*:*/*" }, { "url": "http://*:*/*" }, { "url": "https://*/*" }, { "url": "http://*/*" }]
    }
  ]
}
