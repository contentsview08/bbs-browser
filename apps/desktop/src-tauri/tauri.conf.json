{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OBB",
  "version": "../package.json",
  "identifier": "io.github.contentsview08.obb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OBB",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://cdn.jsdelivr.net",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost",
        "media-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: https://cdn.jsdelivr.net",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://cdn.jsdelivr.net",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost",
        "media-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: https://cdn.jsdelivr.net",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/background-*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "contentsview08",
    "shortDescription": "コネクタで掲示板を読む専用ブラウザ",
    "longDescription": "5ch・したらば・ふたばなどを、掲示板ごとのコネクタで読む PC 向けの専用ブラウザ。外付けのコネクタで自作の掲示板も読める",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "ja-JP"
      }
    }
  }
}
