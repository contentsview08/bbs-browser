{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OBB",
  "mainBinaryName": "OBB",
  "version": "../package.json",
  "identifier": "io.github.contentsview08.obb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OBB",
        "width": 1280,
        "height": 800,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost obb-media: http://obb-media.localhost",
        "media-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: asset: http://asset.localhost",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http: asset: http://asset.localhost obb-media: http://obb-media.localhost",
        "media-src": "'self' data: blob: https: http:",
        "font-src": "'self' data: asset: http://asset.localhost",
        "frame-src": "https://www.youtube-nocookie.com https://www.youtube.com",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/background-*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "contentsview08",
    "shortDescription": "コネクタで掲示板を読む専用ブラウザ",
    "longDescription": "5ch・したらば・まちBBS・ふたば・hono-bbs などを、掲示板ごとに組み込んだコネクタで読む PC 向けの専用ブラウザ",
    "category": "Utility",
    "linux": {
      "deb": {
        "recommends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav",
          "fonts-noto-cjk",
          "fonts-noto-color-emoji"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFMUQ4RURDNkYwNzZFRjcKUldUM2JnZHYzSTRkM3VSZzZLSUUxd1hZQWtrMVVvNEJDY3NDVDk4ZVdaOTZVUWIzMEkrdlI0TkQK",
      "endpoints": [
        "https://github.com/contentsview08/bbs-browser/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
