{
  "name": "@bbs-browser/sync-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run -c vitest.workers.config.ts && vitest run -c vitest.node.config.ts",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "test:node": "vitest run -c vitest.node.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "admin": "node scripts/admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "^4.20260310.1",
    "@types/node": "^24.12.0",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260310.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.72.0"
  }
}
