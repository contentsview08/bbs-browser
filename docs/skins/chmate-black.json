{
  "format": "obb-theme",
  "version": 1,
  "name": "ChMate 風(黒)",
  "note": "ChMate の黒に寄せた見た目。真っ黒の地、濃い灰色の帯、桃色の新着の札、水色の読んだスレタイ、青いリンク。カードのレス、人気のレスは本文の色(紫 → 桃 → 赤)、自分のレスは桃色、自分への返信は緑の左の帯",
  "scheme": {
    "from": "oled",
    "base": "#000000",
    "surface": "#000000",
    "text": "#F2F2F2",
    "accent": "#F06292",
    "unread": "#F06292",
    "own": "#FF8FA3",
    "colors": {
      "bar": "#3A3A3A",
      "surface2": "#141414",
      "surface3": "#1E1E1E",
      "border": "#2A2A2A",
      "borderStrong": "#3A3A3A",
      "textMuted": "#9E9E9E",
      "threadReadTitle": "#4DD0E1",
      "posterName": "#BDBDBD",
      "link": "#448AFF",
      "newBadge": "#F06292",
      "newBadgeText": "#FFFFFF",
      "heatWarm": "#AB47BC",
      "heatHot": "#EC407A",
      "heatVeryHot": "#EF5350",
      "markFav": "#F2C14E",
      "toOwn": "#66BB6A"
    }
  },
  "accent": "",
  "settings": {
    "followOsTheme": false,
    "postStyle": "card",
    "dateStyle": "full",
    "idPosition": "header",
    "idStyle": "none",
    "idShort": false,
    "heatStyle": "text",
    "highlightOp": true,
    "nameSubtle": true,
    "omitNoname": false,
    "watchoiShort": false,
    "iconFromWatchoi": false,
    "urlShorten": false,
    "tidyBlankLines": false,
    "showMinimap": true,
    "showLinkPreview": false,
    "listShape": "normal",
    "unreadFirst": false,
    "keywordBands": true
  },
  "android": {
    "styleOptions": { "card": { "tree": false, "treeDepth": 3, "quote": "line", "group": true } }
  },
  "pc": {
    "styleOptions": { "card": { "tree": false } }
  }
}
