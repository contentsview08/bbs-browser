{
  "format": "obb-theme",
  "version": 1,
  "name": "ChMate 風(ダーク)",
  "note": "ChMate のダークに寄せた見た目。濃い灰色の地、紫の新着の札、専ブラ風のレス(番号・名前・日時・ID を 1 行に)、右にミニマップ。人気のレスは本文の色、自分のレス・自分への返信は左の帯",
  "scheme": {
    "from": "gray",
    "base": "#313131",
    "surface": "#313131",
    "text": "#F4F4F4",
    "accent": "#8E6BC8",
    "unread": "#8E6BC8",
    "own": "#FF8FA3",
    "colors": {
      "bar": "#575757",
      "surface2": "#3A3A3A",
      "surface3": "#434343",
      "border": "#262626",
      "borderStrong": "#1A1A1A",
      "textMuted": "#A8A8A8",
      "threadReadTitle": "#64B5F6",
      "posterName": "#B0B0B0",
      "link": "#6AA6E8",
      "newBadge": "#8E6BC8",
      "newBadgeText": "#FFFFFF",
      "heatWarm": "#7986CB",
      "heatHot": "#AB47BC",
      "heatVeryHot": "#EF5350",
      "markFav": "#F2C14E"
    }
  },
  "accent": "",
  "settings": {
    "followOsTheme": false,
    "postStyle": "classic",
    "dateStyle": "full",
    "idPosition": "header",
    "idStyle": "none",
    "idShort": false,
    "heatStyle": "text",
    "highlightOp": true,
    "nameSubtle": true,
    "omitNoname": false,
    "watchoiShort": false,
    "iconFromWatchoi": false,
    "urlShorten": false,
    "tidyBlankLines": false,
    "showMinimap": true,
    "showLinkPreview": false,
    "listShape": "normal",
    "unreadFirst": false,
    "keywordBands": true
  },
  "android": {
    "styleOptions": { "classic": { "tree": false, "treeDepth": 3, "quote": "line", "group": true } }
  },
  "pc": {
    "styleOptions": { "classic": { "tree": false } }
  }
}
