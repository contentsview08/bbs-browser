{
  "name": "bbs-browser",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run tauri -w @bbs-browser/desktop -- dev",
    "build": "npm run tauri -w @bbs-browser/desktop -- build",
    "test": "npm test -w @bbs-browser/connectors -w @bbs-browser/logstore -w @bbs-browser/desktop",
    "typecheck": "npm run typecheck -w @bbs-browser/connectors -w @bbs-browser/logstore && npx -w @bbs-browser/desktop tsc --noEmit"
  }
}
