{
  "name": "bbs-browser",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run tauri -w @bbs-browser/desktop -- dev",
    "build": "npm run tauri -w @bbs-browser/desktop -- build",
    "test": "npm test -w @bbs-browser/connectors -w @bbs-browser/logstore -w @bbs-browser/desktop",
    "typecheck": "npm run typecheck -w @bbs-browser/connectors -w @bbs-browser/logstore && npx -w @bbs-browser/desktop tsc --noEmit",
    "version:set": "node scripts/set-version.mjs",
    "licenses:gen": "node scripts/gen-licenses.mjs",
    "package:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-zip.ps1",
    "android:init": "npm run tauri -w @bbs-browser/desktop -- android init",
    "android:dev": "npm run tauri -w @bbs-browser/desktop -- android dev",
    "android:build": "npm run tauri -w @bbs-browser/desktop -- android build --apk",
    "android:release": "node scripts/android-release.mjs"
  }
}
