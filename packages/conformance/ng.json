[
  {"name": "文字: 大文字小文字を区別しない", "input": {"pattern": "abc", "isRegex": false, "target": "content", "text": "xABCy"}, "expected": {"valid": true, "match": true, "ranges": [[1, 4]]}},
  {"name": "文字: 全角も区別しない", "input": {"pattern": "ａｂｃ", "isRegex": false, "target": "content", "text": "ＡＢＣ"}, "expected": {"valid": true, "match": true, "ranges": [[0, 3]]}},
  {"name": "文字: 何度でも当たる", "input": {"pattern": "ab", "isRegex": false, "target": "content", "text": "abxab"}, "expected": {"valid": true, "match": true, "ranges": [[0, 2], [3, 5]]}},
  {"name": "文字: 当たらない", "input": {"pattern": "abc", "isRegex": false, "target": "content", "text": "xyz"}, "expected": {"valid": true, "match": false, "ranges": []}},
  {"name": "ID: 文字は完全一致", "input": {"pattern": "abc", "isRegex": false, "target": "posterId", "text": "abcd"}, "expected": {"valid": true, "match": false, "ranges": []}},
  {"name": "ID: 同じ", "input": {"pattern": "abc", "isRegex": false, "target": "posterId", "text": "abc"}, "expected": {"valid": true, "match": true, "ranges": [[0, 3]]}},
  {"name": "ID: 前の形の BE:番号 の NG も、今の数字だけの ID に当たる", "input": {"pattern": "BE:834922174", "isRegex": false, "target": "posterId", "text": "834922174"}, "expected": {"valid": true, "match": true}},
  {"name": "ID: 正規表現は部分一致", "input": {"pattern": "^ab", "isRegex": true, "target": "posterId", "text": "abcd"}, "expected": {"valid": true, "match": true, "ranges": [[0, 2]]}},
  {"name": "正規表現: 大文字小文字を区別する", "input": {"pattern": "abc", "isRegex": true, "target": "content", "text": "ABC"}, "expected": {"valid": true, "match": false, "ranges": []}},
  {"name": "正規表現: 先頭の (?i) で区別しない", "input": {"pattern": "(?i)abc", "isRegex": true, "target": "content", "text": "xABC"}, "expected": {"valid": true, "match": true, "ranges": [[1, 4]]}},
  {"name": "正規表現: (?i) は全角にも効く", "input": {"pattern": "(?i)ａｂｃ", "isRegex": true, "target": "content", "text": "ＡＢＣ"}, "expected": {"valid": true, "match": true, "ranges": [[0, 3]]}},
  {"name": "正規表現: 途中の (?i) は読めない", "input": {"pattern": "a(?i)bc", "isRegex": true, "target": "content", "text": "aBC"}, "expected": {"valid": false, "match": false}},
  {"name": "正規表現: (?i: も読めない", "input": {"pattern": "(?i:a)b", "isRegex": true, "target": "content", "text": "Ab"}, "expected": {"valid": false, "match": false}},
  {"name": "正規表現: [ ] の中の (? はただの文字", "input": {"pattern": "[(?i]a", "isRegex": true, "target": "content", "text": "ia"}, "expected": {"valid": true, "match": true, "ranges": [[0, 2]]}},
  {"name": "正規表現: \\p{Han} は漢字", "input": {"pattern": "\\p{Han}+", "isRegex": true, "target": "content", "text": "あ漢字い"}, "expected": {"valid": true, "match": true, "ranges": [[1, 3]]}},
  {"name": "正規表現: \\p{Han} は文字の p{Han} ではない", "input": {"pattern": "\\p{Han}", "isRegex": true, "target": "content", "text": "p{Han}"}, "expected": {"valid": true, "match": false, "ranges": []}},
  {"name": "正規表現: \\P{Han}", "input": {"pattern": "\\P{Han}", "isRegex": true, "target": "content", "text": "漢a"}, "expected": {"valid": true, "match": true, "ranges": [[1, 2]]}},
  {"name": "正規表現: \\p{Hiragana}", "input": {"pattern": "\\p{Hiragana}+", "isRegex": true, "target": "content", "text": "漢あい"}, "expected": {"valid": true, "match": true, "ranges": [[1, 3]]}},
  {"name": "正規表現: \\p{Katakana}", "input": {"pattern": "\\p{Katakana}+", "isRegex": true, "target": "content", "text": "あアイ"}, "expected": {"valid": true, "match": true, "ranges": [[1, 3]]}},
  {"name": "正規表現: \\p{L}", "input": {"pattern": "\\p{L}+", "isRegex": true, "target": "content", "text": "1a漢"}, "expected": {"valid": true, "match": true, "ranges": [[1, 3]]}},
  {"name": "正規表現: 知らない \\p は読めない", "input": {"pattern": "\\p{Nanika}", "isRegex": true, "target": "content", "text": "a"}, "expected": {"valid": false, "match": false}},
  {"name": "正規表現: \\\\p{Han} は \\ と文字", "input": {"pattern": "\\\\p\\{Han\\}", "isRegex": true, "target": "content", "text": "\\p{Han}"}, "expected": {"valid": true, "match": true, "ranges": [[0, 7]]}},
  {"name": "正規表現: 絵文字は 1 文字", "input": {"pattern": "^.$", "isRegex": true, "target": "content", "text": "😀"}, "expected": {"valid": true, "match": true, "ranges": [[0, 2]]}},
  {"name": "正規表現: \\d は半角だけ", "input": {"pattern": "\\d+", "isRegex": true, "target": "content", "text": "１2"}, "expected": {"valid": true, "match": true, "ranges": [[1, 2]]}},
  {"name": "正規表現: \\D は全角の数字に当たる", "input": {"pattern": "\\D", "isRegex": true, "target": "content", "text": "１"}, "expected": {"valid": true, "match": true, "ranges": [[0, 1]]}},
  {"name": "正規表現: \\w は半角だけ", "input": {"pattern": "\\w+", "isRegex": true, "target": "content", "text": "漢a_1"}, "expected": {"valid": true, "match": true, "ranges": [[1, 4]]}},
  {"name": "正規表現: \\W", "input": {"pattern": "\\W", "isRegex": true, "target": "content", "text": "漢"}, "expected": {"valid": true, "match": true, "ranges": [[0, 1]]}},
  {"name": "正規表現: \\s は全角の空白に当たる", "input": {"pattern": "a\\sb", "isRegex": true, "target": "content", "text": "a　b"}, "expected": {"valid": true, "match": true, "ranges": [[0, 3]]}},
  {"name": "正規表現: [ ] の中の \\d", "input": {"pattern": "[\\d]+", "isRegex": true, "target": "content", "text": "１2"}, "expected": {"valid": true, "match": true, "ranges": [[1, 2]]}},
  {"name": "正規表現: [ ] の中の \\s", "input": {"pattern": "[\\s]", "isRegex": true, "target": "content", "text": "　"}, "expected": {"valid": true, "match": true, "ranges": [[0, 1]]}},
  {"name": "正規表現: [^\\d]", "input": {"pattern": "[^\\d]", "isRegex": true, "target": "content", "text": "１"}, "expected": {"valid": true, "match": true, "ranges": [[0, 1]]}},
  {"name": "正規表現: \\b は半角の語の境目", "input": {"pattern": "\\bab\\b", "isRegex": true, "target": "content", "text": "漢ab漢"}, "expected": {"valid": true, "match": true, "ranges": [[1, 3]]}},
  {"name": "正規表現: \\b は漢字の間にない", "input": {"pattern": "\\b漢", "isRegex": true, "target": "content", "text": "あ漢"}, "expected": {"valid": true, "match": false, "ranges": []}},
  {"name": "正規表現: $ は最後の改行の前に当たらない", "input": {"pattern": "a$", "isRegex": true, "target": "content", "text": "a\n"}, "expected": {"valid": true, "match": false, "ranges": []}},
  {"name": "正規表現: ^ は 2 行目に当たらない", "input": {"pattern": "^b", "isRegex": true, "target": "content", "text": "a\nb"}, "expected": {"valid": true, "match": false, "ranges": []}},
  {"name": "正規表現: . は改行に当たらない", "input": {"pattern": "a.b", "isRegex": true, "target": "content", "text": "a\nb"}, "expected": {"valid": true, "match": false, "ranges": []}},
  {"name": "正規表現: 例の形", "input": {"pattern": "^ｷﾀ━+|ｗ{5,}", "isRegex": true, "target": "content", "text": "wｗｗｗｗｗ"}, "expected": {"valid": true, "match": true, "ranges": [[1, 6]]}},
  {"name": "正規表現: 数の範囲", "input": {"pattern": "a{2}", "isRegex": true, "target": "content", "text": "aaa"}, "expected": {"valid": true, "match": true, "ranges": [[0, 2]]}},
  {"name": "正規表現: 対のない { は文字", "input": {"pattern": "a{", "isRegex": true, "target": "content", "text": "a{"}, "expected": {"valid": true, "match": true, "ranges": [[0, 2]]}},
  {"name": "正規表現: 対のない } は文字", "input": {"pattern": "a}", "isRegex": true, "target": "content", "text": "a}"}, "expected": {"valid": true, "match": true, "ranges": [[0, 2]]}},
  {"name": "正規表現: 対のない ] は文字", "input": {"pattern": "a]", "isRegex": true, "target": "content", "text": "a]"}, "expected": {"valid": true, "match": true, "ranges": [[0, 2]]}},
  {"name": "正規表現: \\- も読める", "input": {"pattern": "a\\-b", "isRegex": true, "target": "content", "text": "a-b"}, "expected": {"valid": true, "match": true, "ranges": [[0, 3]]}},
  {"name": "正規表現: [ ] の中の [ はただの文字", "input": {"pattern": "[[a]", "isRegex": true, "target": "content", "text": "["}, "expected": {"valid": true, "match": true, "ranges": [[0, 1]]}},
  {"name": "正規表現: [ ] の中の && はただの文字", "input": {"pattern": "[a&&b]", "isRegex": true, "target": "content", "text": "&"}, "expected": {"valid": true, "match": true, "ranges": [[0, 1]]}},
  {"name": "正規表現: 空に当たるものは色を付けない", "input": {"pattern": "x*", "isRegex": true, "target": "content", "text": "a"}, "expected": {"valid": true, "match": true, "ranges": []}},
  {"name": "正規表現: 読めない", "input": {"pattern": "(", "isRegex": true, "target": "content", "text": "a"}, "expected": {"valid": false, "match": false}}
]
