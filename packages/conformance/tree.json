[
  {"name": "アンカーのないレスは根、あるレスは最初のアンカー先のすぐ下(親の子の中では番号の順)",
   "input": {"posts": [[1, "最初"], [2, ">>1\nそれな"], [3, "ふつう"], [4, ">>2\nだよね"], [5, ">>1 わかる"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 2, "depth": 1}, {"no": 4, "depth": 2}, {"no": 5, "depth": 1}, {"no": 3, "depth": 0}]},
  {"name": "範囲のアンカー(>>1-3)は 3 つのアンカー先。2 つ目・3 つ目の下には薄く子なしで出す",
   "input": {"posts": [[1, "a"], [2, "b"], [3, "c"], [4, ">>1-3 まとめて"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 4, "depth": 1}, {"no": 2, "depth": 0}, {"no": 4, "depth": 1, "ghost": true}, {"no": 3, "depth": 0}, {"no": 4, "depth": 1, "ghost": true}]},
  {"name": "複数のアンカー(>>3,2)は本文に出てきた順の最初が親",
   "input": {"posts": [[1, "a"], [2, "b"], [3, "c"], [4, ">>3,2 どっちも"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 2, "depth": 0}, {"no": 4, "depth": 1, "ghost": true}, {"no": 3, "depth": 0}, {"no": 4, "depth": 1}]},
  {"name": "アンカー先が 4 つ以上なら最初の親の下だけ",
   "input": {"posts": [[1, "a"], [2, "b"], [3, "c"], [4, "d"], [5, ">>1 >>2 >>3 >>4"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 5, "depth": 1}, {"no": 2, "depth": 0}, {"no": 3, "depth": 0}, {"no": 4, "depth": 0}]},
  {"name": "範囲で 4 つ以上(>>1-4)も最初の親の下だけ",
   "input": {"posts": [[1, "a"], [2, "b"], [3, "c"], [4, "d"], [5, ">>1-4"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 5, "depth": 1}, {"no": 2, "depth": 0}, {"no": 3, "depth": 0}, {"no": 4, "depth": 0}]},
  {"name": "自分より後ろ・自分・スレの外へのアンカーはないものとして扱う(ほかになければ根)",
   "input": {"posts": [[1, "a"], [2, ">>3 未来"], [3, ">>3 自分"], [4, ">>999 外"], [5, ">>9 >>1 外と 1"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 5, "depth": 1}, {"no": 2, "depth": 0}, {"no": 3, "depth": 0}, {"no": 4, "depth": 0}]},
  {"name": "数えるのは使えるアンカー先だけ(外へのアンカーを除いて 3 つまでなら重ねて出す)",
   "input": {"posts": [[1, "a"], [2, "b"], [3, "c"], [4, ">>1 >>2 >>3 >>500"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 4, "depth": 1}, {"no": 2, "depth": 0}, {"no": 4, "depth": 1, "ghost": true}, {"no": 3, "depth": 0}, {"no": 4, "depth": 1, "ghost": true}]},
  {"name": "あぼーんのレスへのアンカーはないものとして扱う。あぼーんのレス自身の 2 回目以降は出さない",
   "input": {"posts": [[1, "a"], [2, "荒らし"], [3, ">>2 釣られた"], [4, ">>2 >>1"], [5, ">>1 >>3 これもNG"]], "aborn": [2, 5], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 4, "depth": 1}, {"no": 5, "depth": 1}, {"no": 2, "depth": 0}, {"no": 3, "depth": 0}]},
  {"name": "深さの上限を超えたら、上限の段のまま並べる(親子の順は保つ)",
   "input": {"posts": [[1, "a"], [2, ">>1"], [3, ">>2"], [4, ">>3"], [5, ">>4"], [6, ">>5"], [7, ">>2"]], "aborn": [], "maxDepth": 3},
   "expected": [{"no": 1, "depth": 0}, {"no": 2, "depth": 1}, {"no": 3, "depth": 2}, {"no": 4, "depth": 3}, {"no": 5, "depth": 3}, {"no": 6, "depth": 3}, {"no": 7, "depth": 2}]},
  {"name": "2 回目以降の出現には子のツリーを付けない(子は 1 回目の下だけ)",
   "input": {"posts": [[1, "a"], [2, "b"], [3, ">>1 >>2"], [4, ">>3"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 3, "depth": 1}, {"no": 4, "depth": 2}, {"no": 2, "depth": 0}, {"no": 3, "depth": 1, "ghost": true}]},
  {"name": "同じ先へのアンカーが重なっても 1 つ",
   "input": {"posts": [[1, "a"], [2, ">>1 >>1 >>1"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 2, "depth": 1}]},
  {"name": "番号が飛んでいても(取れていないレス)見つからないアンカーはないもの",
   "input": {"posts": [[1, "a"], [3, ">>2"], [4, ">>3"]], "aborn": [], "maxDepth": 6},
   "expected": [{"no": 1, "depth": 0}, {"no": 3, "depth": 0}, {"no": 4, "depth": 1}]},
  {"name": "空のスレは空",
   "input": {"posts": [], "aborn": [], "maxDepth": 6},
   "expected": []}
]
